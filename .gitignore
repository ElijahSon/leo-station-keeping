# =============================================================================
# MATLAB / Simulink / Embedded Coder .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# MATLAB editor / session files
# ---------------------------------------------------------------------------
*.asv
*.m~
*.autosave

# ---------------------------------------------------------------------------
# Simulink model backups and cache
# ---------------------------------------------------------------------------
*.slx.r*
*.mdl.r*
*.slxc
*.slx.original
*.slx.bak

# Simulink project / build cache
slprj/
sccprj/

# Simulink Data Dictionary lock/backup
*.sldd.lock
*.sldd.bak

# Simulink cache and autosave folders
*_autosave/

# ---------------------------------------------------------------------------
# Code generation (Simulink Coder / Embedded Coder / MATLAB Coder)
# Generated C/C++ lives inside these folders. They are reproducible from the
# model, so they are ignored by default.
#
# If you WANT to commit the generated code (e.g. to showcase the workflow),
# delete the matching lines below, or force-add a specific folder with:
#   git add -f src/MyModel_ert_rtw/
# ---------------------------------------------------------------------------
codegen/
*_ert_rtw/
*_grt_rtw/
*_rtw/
*_sfun_rtw/
_sharedutils/

# Simulink report generator output
*_codegen_rpt/
html/

# Code generation logs and traceability
*.codegenReport
buildInfo.mat
*_traceability_report.html

# Coder hardware/arithmetic assumption checks
coderassumptions/

# ---------------------------------------------------------------------------
# Software-in-the-loop / Processor-in-the-loop (SIL/PIL) artifacts
# ---------------------------------------------------------------------------
*_sil/
*_pil/
slbuild/

# ---------------------------------------------------------------------------
# Compiled build outputs (always safe to ignore)
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.elf
*.hex
*.bin
*.map
*.lst
*.mex*

# Build system files generated by Coder
*.mk
*.rsp
*.bat
Makefile.*
*.tmw
*.tlc.cache

# ---------------------------------------------------------------------------
# MATLAB result / data files
# Large *.mat data is ignored by default. Force-add specific datasets with:
#   git add -f results/your_data.mat
# ---------------------------------------------------------------------------
*.mat
*.mat.bak

# ---------------------------------------------------------------------------
# Simulink cache/log files created during simulation
# ---------------------------------------------------------------------------
*.slxc
*.log
*.diary

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
octave-workspace
.vscode/
.idea/
